<UserControl x:Class="AutoSolid.Views.MainTaskpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoSolid.Views"
             xmlns:vm="clr-namespace:AutoSolid.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="860" d:DesignWidth="430"
             Background="{DynamicResource SwAppBgBrush}"
             FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource SwTextDarkBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- ========================================================================= -->
        <!-- PALETA DINÂMICA SOLIDWORKS VERMELHA (MODO ESCURO & MODO CLARO)            -->
        <!-- ========================================================================= -->
        <SolidColorBrush x:Key="SwAppBgBrush" Color="#363636"/>
        <SolidColorBrush x:Key="SwHeaderBgBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="SwHeaderBorderBrush" Color="#505050"/>
        <SolidColorBrush x:Key="SwSurfaceBgBrush" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="SwPanelBgBrush" Color="#454545"/>
        <SolidColorBrush x:Key="SwGroupHeaderBgBrush" Color="#333333"/>
        <SolidColorBrush x:Key="SwBorderBrush" Color="#585858"/>
        <SolidColorBrush x:Key="SwInputBgBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="SwInputReadOnlyBgBrush" Color="#343434"/>
        <SolidColorBrush x:Key="SwInputBorderBrush" Color="#626262"/>
        <SolidColorBrush x:Key="SwDropZoneBgBrush" Color="#382F2F"/>
        <SolidColorBrush x:Key="SwDropZoneBorderBrush" Color="#9E3838"/>

        <SolidColorBrush x:Key="SwTextDarkBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="SwTextMutedBrush" Color="#B5B8BC"/>
        <SolidColorBrush x:Key="SwTextHighlightBrush" Color="#FF5C5C"/>

        <!-- Vermelho Oficial SolidWorks / BiblioteCad -->
        <SolidColorBrush x:Key="SwBlueBrush" Color="#C81E1E"/>
        <SolidColorBrush x:Key="SwBlueHoverBrush" Color="#E02828"/>
        <SolidColorBrush x:Key="SwBlueLightBgBrush" Color="#4A2020"/>
        <SolidColorBrush x:Key="SwBlueBorderBrush" Color="#F04444"/>

        <SolidColorBrush x:Key="SwGreenBrush" Color="#168A4A"/>
        <SolidColorBrush x:Key="SwGreenHoverBrush" Color="#1DA359"/>

        <SolidColorBrush x:Key="SwSecondaryBtnBgBrush" Color="#4E4E4E"/>
        <SolidColorBrush x:Key="SwSecondaryBtnBorderBrush" Color="#686868"/>

        <SolidColorBrush x:Key="SwDangerBgBrush" Color="#4A2727"/>
        <SolidColorBrush x:Key="SwDangerBorderBrush" Color="#8A3E3E"/>
        <SolidColorBrush x:Key="SwDangerTextBrush" Color="#FF9494"/>

        <SolidColorBrush x:Key="SwTabInactiveBgBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="SwTabInactiveTextBrush" Color="#A6A8AA"/>

        <SolidColorBrush x:Key="SwGridBgBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="SwGridAltRowBgBrush" Color="#313131"/>
        <SolidColorBrush x:Key="SwGridHeaderBgBrush" Color="#353535"/>
        <SolidColorBrush x:Key="SwGridLinesBrush" Color="#474747"/>
        <SolidColorBrush x:Key="SwGridSelectedBgBrush" Color="#6B1D1D"/>
        <SolidColorBrush x:Key="SwGridSelectedTextBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="SwBannerBgBrush" Color="#173D28"/>
        <SolidColorBrush x:Key="SwBannerBorderBrush" Color="#2E8B57"/>
        <SolidColorBrush x:Key="SwBannerTextBrush" Color="#85EEB1"/>
        <SolidColorBrush x:Key="SwBadgeBgBrush" Color="#4A1E1E"/>

        <!-- ========================================================================= -->
        <!-- ESTILOS DE CONTROLES NATIVOS SOLIDWORKS (DARK & LIGHT COMPATÍVEIS)        -->
        <!-- ========================================================================= -->

        <!-- TextBox CAD -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource SwInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SwInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SwBlueBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SwBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Item CAD -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SwInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SwGridSelectedBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SwGridSelectedTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SwBlueLightBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox CAD (Suporta IsEditable=False e IsEditable=True no Modo Escuro/Claro) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SwInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SwInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="{DynamicResource SwInputBgBrush}"
                                                BorderBrush="{DynamicResource SwInputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="{DynamicResource SwTextMutedBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource SwBlueBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="7,2,24,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource SwTextDarkBrush}"
                                     CaretBrush="{DynamicResource SwTextDarkBrush}"
                                     BorderThickness="0"
                                     Margin="4,1,23,1"
                                     VerticalAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource SwInputBgBrush}"
                                            BorderBrush="{DynamicResource SwBlueBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário SolidWorks (Vermelho Oficial BiblioteCad) -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SwBlueBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SwBlueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SwBlueHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SwGroupHeaderBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SwBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SwTextMutedBrush}"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário (Estilo Toolbar Nativo do SolidWorks) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SwSecondaryBtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SwSecondaryBtnBorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SwBlueLightBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SwBlueBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Confirmação / Aprovação (Verde Check PropertyManager) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SwGreenBrush}"/>
            <Setter Property="BorderBrush" Value="#25A862"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SwGreenHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SwGroupHeaderBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SwBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SwTextMutedBrush}"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Remoção / Cancelar -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SwDangerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwDangerTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SwDangerBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B6B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Nativo para DataGrid (Tabelas de Engenharia) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SwGridHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SwGridLinesBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SwGridSelectedBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SwGridSelectedTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra Superior BiblioteCad + Logo + Botão Tema -->
            <RowDefinition Height="*"/>    <!-- Abas de Fluxo Guiado -->
            <RowDefinition Height="Auto"/> <!-- Console Técnico Retrátil -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- CABEÇALHO SUPERIOR BIBLIOTECAD COM LOGO CUBO 3D E SELETOR DE TEMA         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SwHeaderBgBrush}"
                BorderBrush="{DynamicResource SwHeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Faixa Lateral Vermelha SolidWorks -->
                <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="2,0,0,2"/>

                <!-- Logo Oficial BC 3D + Nome BiblioteCad -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,5,6,5" VerticalAlignment="Center">
                    <Image x:Name="HeaderLogoImage"
                           Width="28" Height="28"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BiblioteCad" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}"/>
                            <Border Background="{DynamicResource SwBadgeBgBrush}" CornerRadius="2" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SOLIDWORKS 3D" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource SwTextHighlightBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Automação Inteligente de Bibliotecas CAD" FontSize="9.5" Foreground="{DynamicResource SwTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botão Alternador Claro / Escuro no Canto Superior Direito -->
                <Button Grid.Column="2"
                        Content="{Binding ThemeButtonText}"
                        Command="{Binding AlternarTemaCommand}"
                        ToolTip="{Binding ThemeButtonTooltip}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="9,4"
                        Height="26"
                        FontSize="10.5"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ABAS DE FLUXO ESTILO COMMANDMANAGER DO SOLIDWORKS                         -->
        <!-- ========================================================================= -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SwBorderBrush}"
                    Background="{DynamicResource SwSurfaceBgBrush}"
                    Padding="5">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="{DynamicResource SwTabInactiveBgBrush}"
                                        BorderBrush="{DynamicResource SwBorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="3,3,0,0"
                                        Padding="13,6"
                                        Margin="0,0,4,0"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="11"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource SwSurfaceBgBrush}"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource SwBlueBrush}"/>
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2.5,1,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SwTextHighlightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource SwTabInactiveTextBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="False"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource SwBlueLightBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SwTextDarkBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ========================================================================= -->
            <!-- ABA 1: PEÇA-TEMPLATE E MAPEAMENTO DE COTAS / EXTRUSÕES                     -->
            <!-- ========================================================================= -->
            <TabItem Header="1. Peça &amp; Cotas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,4,2,8">

                        <!-- PASSO 1: PEÇA-TEMPLATE ATIVA -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{DynamicResource SwGroupHeaderBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="1"/>
                                        <TextBlock Grid.Column="1" Text="1. Peça-Template Ativa (.SLDPRT)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                        <Button Grid.Column="2" Content="↻ Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding AtualizarModeloAtivoCommand}" Padding="7,2" FontSize="10"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Modelo:" FontSize="10.5" Foreground="{DynamicResource SwTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Border Grid.Column="1" Background="{DynamicResource SwInputBgBrush}" BorderBrush="{DynamicResource SwInputBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="7,4">
                                        <TextBlock Text="{Binding ActiveTemplateName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SwTextHighlightBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PASSO 2: SELEÇÃO CONTÍNUA DE COTAS / ESBOÇOS / EXTRUSÕES -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{DynamicResource SwGroupHeaderBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="1"/>
                                        <TextBlock Grid.Column="1" Text="2. Mapeamento de Cotas e Extrusões" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource SwBadgeBgBrush}" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MappingsCountText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SwTextHighlightBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,8">
                                    <TextBlock Text="Clique 1 vez no botão abaixo e selecione diretamente as cotas, esboços ou extrusões no SolidWorks. Dê um Apelido (IA) claro para cada medida:" 
                                               FontSize="10.5" Foreground="{DynamicResource SwTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>

                                    <Button Content="{Binding SelectDimensionButtonText}"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding IniciarSelecaoCotaCommand}"
                                            FontSize="11" Height="28" Margin="0,0,0,7"/>

                                    <!-- Banner de Captura Contínua Ativa -->
                                    <Border Visibility="{Binding IsSelectingDimension, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{DynamicResource SwBannerBgBrush}"
                                            BorderBrush="{DynamicResource SwBannerBorderBrush}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,5" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SelectionPromptText}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SwBannerTextBrush}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="✕"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelarSelecaoCotaCommand}"
                                                    ToolTip="Encerrar modo de captura"
                                                    Width="23" Height="22" Padding="0" FontSize="10"/>
                                        </Grid>
                                    </Border>

                                    <!-- Tabela de Cotas Mapeadas com Exclusão ✕ em 1 Clique -->
                                    <DataGrid x:Name="MappingsDataGrid"
                                              ItemsSource="{Binding Mappings}"
                                              SelectedItem="{Binding SelectedMapping}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="120" MaxHeight="195"
                                              BorderBrush="{DynamicResource SwInputBorderBrush}"
                                              BorderThickness="1"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="{DynamicResource SwGridLinesBrush}"
                                              VerticalGridLinesBrush="{DynamicResource SwGridLinesBrush}"
                                              Background="{DynamicResource SwGridBgBrush}"
                                              RowBackground="{DynamicResource SwGridBgBrush}"
                                              AlternatingRowBackground="{DynamicResource SwGridAltRowBgBrush}"
                                              RowHeight="25">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cota SolidWorks" Binding="{Binding FullName}" IsReadOnly="True" Width="1.25*"/>
                                            <DataGridTextColumn Header="Apelido (IA) ✎" Binding="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Width="*"/>
                                            <DataGridTextColumn Header="Atual (mm)" Binding="{Binding CurrentValueMm, StringFormat={}{0:F2}}" IsReadOnly="True" Width="0.72*"/>
                                            <DataGridTemplateColumn Header="" Width="30" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕"
                                                                Style="{StaticResource DangerButton}"
                                                                Command="{Binding DataContext.RemoverCotaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Remover esta cota com 1 clique"
                                                                Width="20" Height="18" Padding="0" FontSize="9.5" FontWeight="Bold"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PASSO 3: PASTA DE DESTINO DA BIBLIOTECA -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{DynamicResource SwGroupHeaderBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="1"/>
                                        <TextBlock Grid.Column="1" Text="3. Pasta de Destino da Biblioteca" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}" Margin="7,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,6,0" FontSize="11"/>
                                    <Button Grid.Column="1" Content="📁 Procurar..." Style="{StaticResource SecondaryButton}" Command="{Binding SelecionarPastaDestinoCommand}" Height="25" Padding="10,0" FontSize="10.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BOTÃO AVANÇAR -->
                        <Button Content="Avançar para Catálogo &amp; Extração IA ➔"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding AvancarParaAba2Command}"
                                Height="31" Margin="0,2,0,4" FontSize="11.5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- ABA 2: EXTRAÇÃO INTELIGENTE COM IA E GERAÇÃO EM LOTE                       -->
            <!-- ========================================================================= -->
            <TabItem Header="2. Catálogo IA &amp; Geração">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,4,2,8">

                        <!-- SEÇÃO 1: CONFIGURAÇÃO DE IA E ARQUIVO DE ENTRADA -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6">
                            <StackPanel>
                                <Border Background="{DynamicResource SwGroupHeaderBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="1"/>
                                        <TextBlock Grid.Column="1" Text="1. Leitura Inteligente de Desenho / Tabela (IA)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}" Margin="7,0,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,8">
                                    <!-- Provedor e Modelo -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="138"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Provedor de IA:" FontSize="10" Foreground="{DynamicResource SwTextMutedBrush}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Modelo Ativo:" FontSize="10" Foreground="{DynamicResource SwTextMutedBrush}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🔍 Modelos" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DetectarModelosContaCommand}"
                                                Visibility="{Binding IsGeminiSelected, Converter={StaticResource BoolToVisConverter}}"
                                                VerticalAlignment="Bottom" Margin="5,0,0,0" Padding="7,0" Height="24" FontSize="10"
                                                ToolTip="Detecta automaticamente os modelos ativos na sua conta Google AI Studio"/>
                                    </Grid>

                                    <!-- API Key Persistente com Botão de Editar -->
                                    <StackPanel Margin="0,0,0,7">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding ApiKeyLabel}" FontSize="10" Foreground="{DynamicResource SwTextMutedBrush}"/>
                                            <TextBlock Text="{Binding ApiKeySavedBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SwBannerTextBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsApiKeyLocked}"
                                                     Height="24" FontSize="11">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApiKeyLocked}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SwInputReadOnlyBgBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SwTextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="1"
                                                    Content="{Binding ApiKeyEditIcon}"
                                                    Command="{Binding AlternarEdicaoApiKeyCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="{Binding ApiKeyEditTooltip}"
                                                    Width="27" Height="24" Padding="0" Margin="5,0,0,0" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Área Imersiva de Drag & Drop de Catálogo / Tabela com Logo BC -->
                                    <Border x:Name="DropZoneBorder"
                                            BorderBrush="{DynamicResource SwDropZoneBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Background="{DynamicResource SwDropZoneBgBrush}"
                                            Padding="8,6"
                                            Margin="0,0,0,7"
                                            AllowDrop="True"
                                            Drop="DropZoneBorder_Drop"
                                            DragOver="DropZoneBorder_DragOver">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="DropZoneLogoImage"
                                                   Grid.Column="0"
                                                   Width="22" Height="22"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Catálogo, Desenho ou Tabela (Imagem / PDF / CSV):" FontSize="9.5" Foreground="{DynamicResource SwTextMutedBrush}"/>
                                                <TextBlock Text="{Binding InputFileDisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SwTextHighlightBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding InputFilePath}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="📂 Escolher..." Style="{StaticResource SecondaryButton}" Command="{Binding SelecionarArquivoCommand}" Padding="9,3" Height="24" FontSize="10.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Caixa de Instruções Adicionais (Opcional) -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Instruções para a IA (Opcional — ex: filtrar faixa M4 até M10):" FontSize="10" Foreground="{DynamicResource SwTextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding UserInstructions, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="42"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Padding="6,4"
                                                 FontSize="10.5"
                                                 ToolTip="Oriente a IA caso necessário (ex: 'Extraia apenas do M4 ao M10' ou 'Considere comprimento fixo de 25mm')."/>
                                    </StackPanel>

                                    <!-- Botão de Extração -->
                                    <Button Content="⚡ Extrair Dados da Tabela com IA"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding ExtrairComIaCommand}"
                                            Height="29" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BARRA DE STATUS E TELEMETRIA DE TEMPO -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProgressStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SwTextDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SwTextHighlightBrush}" Margin="6,0,0,0"/>
                                </Grid>

                                <ProgressBar Height="6"
                                             Value="{Binding ProgressValue}"
                                             Minimum="0" Maximum="100"
                                             Foreground="{DynamicResource SwBlueBrush}"
                                             Background="{DynamicResource SwInputBgBrush}"
                                             BorderBrush="{DynamicResource SwBorderBrush}"
                                             BorderThickness="1"
                                             Margin="0,0,0,4"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ElapsedTimeText}" FontSize="9.5" Foreground="{DynamicResource SwTextMutedBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EstimatedTimeText}" FontSize="9.5" Foreground="{DynamicResource SwTextHighlightBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SpeedDetailText}" FontSize="9.5" Foreground="{DynamicResource SwTextMutedBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: TABELA ESTRUTURADA DE VARIAÇÕES E PREFIXO SKU -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6">
                            <StackPanel>
                                <Border Background="{DynamicResource SwGroupHeaderBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SwBlueBrush}" CornerRadius="1"/>
                                        <TextBlock Grid.Column="1" Text="2. Tabela de Variações" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource SwBadgeBgBrush}" CornerRadius="2" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RowsCountText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SwTextHighlightBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="+ Linha" Style="{StaticResource SecondaryButton}" Command="{Binding AdicionarLinhaCommand}" Padding="6,1" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="- Excluir" Style="{StaticResource SecondaryButton}" Command="{Binding RemoverLinhaCommand}" Padding="6,1" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="Limpar" Style="{StaticResource SecondaryButton}" Command="{Binding LimparTabelaCommand}" Padding="6,1" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,8">
                                    <!-- Campo de Prefixo Global do Nome / SKU -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Prefixo do Nome / SKU:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SkuPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="24" FontSize="11"
                                                 ToolTip="Adiciona este nome antes do SKU de todas as peças (ex: 'PARAFUSO ALLEN' transforma 'M5 x 15' em 'PARAFUSO ALLEN M5 x 15')."/>
                                    </Grid>

                                    <!-- DataGrid de Variações -->
                                    <DataGrid x:Name="VariationsDataGrid"
                                              ItemsSource="{Binding Rows}"
                                              SelectedItem="{Binding SelectedRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="190" MaxHeight="340"
                                              BorderBrush="{DynamicResource SwInputBorderBrush}"
                                              BorderThickness="1"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="{DynamicResource SwGridLinesBrush}"
                                              VerticalGridLinesBrush="{DynamicResource SwGridLinesBrush}"
                                              Background="{DynamicResource SwGridBgBrush}"
                                              RowBackground="{DynamicResource SwGridBgBrush}"
                                              AlternatingRowBackground="{DynamicResource SwGridAltRowBgBrush}"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              RowHeight="24" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU / Código" Binding="{Binding Sku}" FontWeight="SemiBold" Width="1.3*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusMessage}" IsReadOnly="True" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: APROVAÇÃO E GERAÇÃO EM LOTE -->
                        <Border Background="{DynamicResource SwPanelBgBrush}" BorderBrush="{DynamicResource SwBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="✔ Aprovar e Gerar Biblioteca (.SLDPRT)"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding GerarBibliotecaCommand}"
                                        Height="31" FontSize="11.5" FontWeight="Bold" Margin="0,0,6,0"/>
                                <Button Grid.Column="1"
                                        Content="Cancelar"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding CancelarCommand}"
                                        Height="31" Width="70" FontSize="11"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ========================================================================= -->
        <!-- BARRA INFERIOR DE REGISTROS (CONSOLE TÉCNICO RETRÁTIL)                    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SwHeaderBgBrush}"
                BorderBrush="{DynamicResource SwBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,5,0,0">
            <Expander IsExpanded="False"
                      Foreground="{DynamicResource SwTextDarkBrush}"
                      FontSize="10.5"
                      FontWeight="SemiBold"
                      Padding="5,3">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ConsoleLogoImage" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Console de Eventos do BiblioteCad" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Border Background="#1B1B1B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="2" Margin="0,4,0,2">
                    <ListBox ItemsSource="{Binding Logs}" Height="110" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D4D4D4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                    <Setter Property="Foreground" Value="#4EC9B0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#DCDCAA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F48771"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Expander>
        </Border>
    </Grid>
</UserControl>
