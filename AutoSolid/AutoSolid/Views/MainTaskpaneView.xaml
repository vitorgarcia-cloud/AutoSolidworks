<UserControl x:Class="AutoSolid.Views.MainTaskpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoSolid.Views"
             xmlns:vm="clr-namespace:AutoSolid.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="420"
             Background="#ECECEC"
             FontFamily="Segoe UI" FontSize="11.5" Foreground="#222222">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Paleta Nativa SolidWorks (PropertyManager / Taskpane CAD) -->
        <SolidColorBrush x:Key="SwBlueBrush" Color="#005A9E"/>
        <SolidColorBrush x:Key="SwBlueHoverBrush" Color="#004578"/>
        <SolidColorBrush x:Key="SwBlueLightBgBrush" Color="#E5F1FB"/>
        <SolidColorBrush x:Key="SwBlueBorderBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="SwGreenBrush" Color="#107C41"/>
        <SolidColorBrush x:Key="SwGreenHoverBrush" Color="#0C5E31"/>
        <SolidColorBrush x:Key="SwDangerBrush" Color="#C42B1C"/>
        <SolidColorBrush x:Key="SwPanelBgBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="SwGroupHeaderBgBrush" Color="#DDE1E5"/>
        <SolidColorBrush x:Key="SwBorderBrush" Color="#C2C4C6"/>
        <SolidColorBrush x:Key="SwInputBorderBrush" Color="#ABADB3"/>
        <SolidColorBrush x:Key="SwTextDarkBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SwTextMutedBrush" Color="#55585C"/>

        <!-- Estilo Padrão de TextBox Nativo CAD -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource SwInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SwBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Primário SolidWorks (Azul CAD) -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SwBlueBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#003E6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SwBlueHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#003359"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D6D6D6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#8C8C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário (Estilo Toolbar Nativo do SolidWorks) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SwBlueLightBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SwBlueBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE4F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E6E6E6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Confirmação / Aprovação (Verde Check PropertyManager) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SwGreenBrush}"/>
            <Setter Property="BorderBrush" Value="#0A522A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SwGreenHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D6D6D6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#8C8C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Remoção / Cancelar -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FDF2F2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#E0B4B4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#961B0E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E6E6E6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Nativo para DataGrid (Tabelas de Engenharia) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DFE2E6"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#C2C4C6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="Foreground" Value="#002B4D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra de Título estilo PropertyManager -->
            <RowDefinition Height="*"/>    <!-- Abas e Painéis -->
            <RowDefinition Height="Auto"/> <!-- Barra Inferior de Console -->
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO ESTILO SOLIDWORKS PROPERTYMANAGER -->
        <Border Grid.Row="0" Background="#D8DCE0" BorderBrush="#B4B8BC" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}"/>
                <StackPanel Grid.Column="1" Margin="8,5,6,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AUTOSOLID" FontSize="12.5" FontWeight="Bold" Foreground="#1A1A1A"/>
                        <TextBlock Text="  |  Automação Paramétrica CAD" FontSize="11" Foreground="#4A4D50" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="#005A9E" CornerRadius="2" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="SW 3D" FontSize="9" Foreground="#FFFFFF" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ABAS ESTILO COMMANDMANAGER / PROPERTYMANAGER -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="1" BorderBrush="{StaticResource SwBorderBrush}" Background="#F2F2F2" Padding="4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="#E1E3E6"
                                        BorderBrush="#C2C4C6"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="2,2,0,0"
                                        Padding="12,5"
                                        Margin="0,0,3,0"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="11"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#F2F2F2"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource SwBlueBrush}"/>
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource SwBlueBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#505050"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="False"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="tabBorder" Property="Background" Value="#EBF2F8"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ========================================================================= -->
            <!-- ABA 1: CONFIGURAÇÃO DO TEMPLATE E MAPEAMENTO DE COTAS                     -->
            <!-- ========================================================================= -->
            <TabItem Header="1. Peça &amp; Mapeamento">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,4,2,8">

                        <!-- SEÇÃO 1: DOCUMENTO ATIVO -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Cabeçalho de Grupo PropertyManager -->
                                <Border Background="{StaticResource SwGroupHeaderBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="Peça-Template Ativa (.SLDPRT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="↻ Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding AtualizarModeloAtivoCommand}" Padding="6,1" FontSize="10"/>
                                    </Grid>
                                </Border>

                                <!-- Conteúdo -->
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arquivo:" FontSize="11" Foreground="{StaticResource SwTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D0D3D6" BorderThickness="1" Padding="6,3">
                                        <TextBlock Text="{Binding ActiveTemplateName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#004578" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: MAPEAMENTO DE COTAS (SKETCH E EXTRUSÃO) -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{StaticResource SwGroupHeaderBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Mapeamento de Cotas (Esboço / Extrusão)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SwTextDarkBrush}" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,7">
                                    <TextBlock Text="1º Clique em Selecionar, 2º Clique na cota ou extrusão no SolidWorks, 3º Confirme no botão verde (✔):" 
                                               FontSize="10.5" Foreground="{StaticResource SwTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="+ Selecionar Cota / Extrusão" Style="{StaticResource ModernButton}" Command="{Binding IniciarSelecaoCotaCommand}" Margin="0,0,5,0" FontSize="11" Height="26"/>
                                        <Button Grid.Column="1" Content="Remover" Style="{StaticResource DangerButton}" Command="{Binding RemoverCotaCommand}" IsEnabled="{Binding CanEditUi}" Padding="10,0" FontSize="11" Height="26"/>
                                    </Grid>

                                    <!-- Painel Interativo de Seleção estilo Callout do SolidWorks -->
                                    <Border Visibility="{Binding IsSelectingDimension, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#EBF7EE" BorderBrush="#5CA974" BorderThickness="1" CornerRadius="2" Padding="6,5" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SelectionPromptText}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#0F5128"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="✔"
                                                    Style="{StaticResource SuccessButton}"
                                                    Command="{Binding ConfirmarCotaCommand}"
                                                    Visibility="{Binding HasPendingDimension, Converter={StaticResource BoolToVisConverter}}"
                                                    ToolTip="Confirmar seleção desta cota/extrusão"
                                                    Width="28" Height="23" Padding="0" FontSize="12" FontWeight="Bold" Margin="0,0,3,0"/>
                                            <Button Grid.Column="2" Content="✕"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelarSelecaoCotaCommand}"
                                                    ToolTip="Cancelar modo de seleção"
                                                    Width="23" Height="23" Padding="0" FontSize="10"/>
                                        </Grid>
                                    </Border>

                                    <!-- Tabela de Cotas Mapeadas -->
                                    <DataGrid x:Name="MappingsDataGrid" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              MinHeight="110" MaxHeight="180"
                                              BorderBrush="#B8BABC" BorderThickness="1"
                                              GridLinesVisibility="All" HorizontalGridLinesBrush="#DCDFE3" VerticalGridLinesBrush="#DCDFE3"
                                              Background="#FFFFFF" AlternatingRowBackground="#F7F8FA" RowHeight="23">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cota SolidWorks" Binding="{Binding FullName}" IsReadOnly="True" Width="1.25*"/>
                                            <DataGridTextColumn Header="Apelido (IA)" Binding="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Width="*"/>
                                            <DataGridTextColumn Header="Atual (mm)" Binding="{Binding CurrentValueMm, StringFormat={}{0:F2}}" IsReadOnly="True" Width="0.75*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: DIRETÓRIO DE DESTINO -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{StaticResource SwGroupHeaderBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Pasta de Destino da Biblioteca" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SwTextDarkBrush}" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Height="24" Margin="0,0,5,0" FontSize="11"/>
                                    <Button Grid.Column="1" Content="Procurar..." Style="{StaticResource SecondaryButton}" Command="{Binding SelecionarPastaDestinoCommand}" Height="24" Padding="10,0" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BOTÃO AVANÇAR -->
                        <Button Content="Avançar para Extração &amp; Tabela ➔" Style="{StaticResource ModernButton}" 
                                Command="{Binding AvancarParaAba2Command}" Height="30" Margin="0,2,0,4" FontSize="11.5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- ABA 2: ENTRADA DE DADOS, IA E GERAÇÃO EM LOTE                             -->
            <!-- ========================================================================= -->
            <TabItem Header="2. Tabela &amp; Geração IA">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,4,2,8">

                        <!-- SEÇÃO 1: CONFIGURAÇÃO DE IA E ARQUIVO DE ENTRADA -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6">
                            <StackPanel>
                                <Border Background="{StaticResource SwGroupHeaderBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}"/>
                                        <TextBlock Grid.Column="1" Text="1. Leitura Inteligente de Desenho / Tabela (IA)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SwTextDarkBrush}" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,7">
                                    <!-- Provedor e Modelo -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Provedor:" FontSize="10" Foreground="{StaticResource SwTextMutedBrush}" Margin="0,0,0,1"/>
                                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" Height="23" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Modelo IA:" FontSize="10" Foreground="{StaticResource SwTextMutedBrush}" Margin="0,0,0,1"/>
                                            <ComboBox ItemsSource="{Binding AvailableModels}" 
                                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      IsEditable="True" Height="23" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🔍 Modelos" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding DetectarModelosContaCommand}" 
                                                Visibility="{Binding IsGeminiSelected, Converter={StaticResource BoolToVisConverter}}"
                                                VerticalAlignment="Bottom" Margin="4,0,0,0" Padding="6,0" Height="23" FontSize="10"
                                                ToolTip="Detecta automaticamente os modelos ativos na sua conta Google AI Studio"/>
                                    </Grid>

                                    <!-- API Key Persistente com Botão de Editar -->
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                            <TextBlock Text="{Binding ApiKeyLabel}" FontSize="10" Foreground="{StaticResource SwTextMutedBrush}"/>
                                            <TextBlock Text="{Binding ApiKeySavedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#107C41" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsApiKeyLocked}"
                                                     Height="23" FontSize="11">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApiKeyLocked}" Value="True">
                                                                <Setter Property="Background" Value="#EAECEE"/>
                                                                <Setter Property="Foreground" Value="#505458"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="1"
                                                    Content="{Binding ApiKeyEditIcon}"
                                                    Command="{Binding AlternarEdicaoApiKeyCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    ToolTip="{Binding ApiKeyEditTooltip}"
                                                    Width="26" Height="23" Padding="0" Margin="4,0,0,0" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Área de Seleção / Drag & Drop de Arquivo -->
                                    <Border x:Name="DropZoneBorder" BorderBrush="#9FA4AA" BorderThickness="1" CornerRadius="2" Background="#EAECEF" Padding="6,5" Margin="0,0,0,6"
                                            AllowDrop="True" Drop="DropZoneBorder_Drop" DragOver="DropZoneBorder_DragOver">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Catálogo / Desenho / Tabela (Arraste ou selecione):" FontSize="9.5" Foreground="{StaticResource SwTextMutedBrush}"/>
                                                <TextBlock Text="{Binding InputFilePath, FallbackValue='Nenhum arquivo selecionado'}" FontWeight="SemiBold" FontSize="11" Foreground="#004578" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Arquivo..." Style="{StaticResource SecondaryButton}" Command="{Binding SelecionarArquivoCommand}" Padding="8,2" Height="23" FontSize="10.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Caixa de Instruções Adicionais (Opcional) -->
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="Instruções para a IA (Opcional):" FontSize="10" Foreground="{StaticResource SwTextMutedBrush}" Margin="0,0,0,1"/>
                                        <TextBox Text="{Binding UserInstructions, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="42"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Padding="5,3"
                                                 FontSize="10.5"
                                                 ToolTip="Oriente a IA caso necessário (ex: 'Considere comprimento fixo de 25mm' ou 'Associe D_EXT à coluna d2')."/>
                                    </StackPanel>

                                    <!-- Botão de Extração -->
                                    <Button Content="⚡ Extrair Dados da Tabela com IA" Style="{StaticResource ModernButton}" 
                                            Command="{Binding ExtrairComIaCommand}" Height="28" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BARRA DE STATUS E TELEMETRIA DE TEMPO -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProgressStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SwTextDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SwBlueBrush}" Margin="6,0,0,0"/>
                                </Grid>

                                <ProgressBar Height="6" Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Foreground="{StaticResource SwBlueBrush}" Background="#D8DCE0" BorderBrush="#B8BABC" BorderThickness="1" Margin="0,0,0,3"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ElapsedTimeText}" FontSize="9.5" Foreground="{StaticResource SwTextMutedBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EstimatedTimeText}" FontSize="9.5" Foreground="{StaticResource SwBlueBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SpeedDetailText}" FontSize="9.5" Foreground="{StaticResource SwTextMutedBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: TABELA ESTRUTURADA DE VARIAÇÕES E PREFIXO SKU -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,6">
                            <StackPanel>
                                <Border Background="{StaticResource SwGroupHeaderBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SwBlueBrush}"/>
                                        <TextBlock Grid.Column="1" Text="2. Tabela Estruturada de Variações" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="+ Linha" Style="{StaticResource SecondaryButton}" Command="{Binding AdicionarLinhaCommand}" Padding="6,1" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="- Excluir" Style="{StaticResource SecondaryButton}" Command="{Binding RemoverLinhaCommand}" Padding="6,1" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="Limpar" Style="{StaticResource SecondaryButton}" Command="{Binding LimparTabelaCommand}" Padding="6,1" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="8,7">
                                    <!-- Campo de Prefixo Global do Nome / SKU -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Prefixo do Nome / SKU:" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SwTextDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SkuPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="23" FontSize="11"
                                                 ToolTip="Adiciona este nome antes do SKU de todas as peças (ex: 'PARAFUSO SEXTAVADO' transforma 'm5 x 15' em 'PARAFUSO SEXTAVADO m5 x 15')."/>
                                    </Grid>

                                    <!-- DataGrid de Variações -->
                                    <DataGrid x:Name="VariationsDataGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              MinHeight="190" MaxHeight="340"
                                              BorderBrush="#B8BABC" BorderThickness="1"
                                              GridLinesVisibility="All" HorizontalGridLinesBrush="#DCDFE3" VerticalGridLinesBrush="#DCDFE3"
                                              Background="#FFFFFF" AlternatingRowBackground="#F7F8FA"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              RowHeight="23" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU / Código" Binding="{Binding Sku}" FontWeight="SemiBold" Width="1.3*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusMessage}" IsReadOnly="True" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: APROVAÇÃO E GERAÇÃO EM LOTE -->
                        <Border Background="{StaticResource SwPanelBgBrush}" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="✔ Aprovar e Gerar Biblioteca (.SLDPRT)" Style="{StaticResource SuccessButton}" 
                                        Command="{Binding GerarBibliotecaCommand}" Height="30" FontSize="11.5" FontWeight="Bold" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource DangerButton}" 
                                        Command="{Binding CancelarCommand}" Height="30" Width="68" FontSize="11"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BARRA INFERIOR DE REGISTROS (CONSOLE TÉCNICO RETRÁTIL) -->
        <Border Grid.Row="2" Background="#DFE2E6" BorderBrush="{StaticResource SwBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,5,0,0">
            <Expander Header="Console de Eventos do SolidWorks" IsExpanded="False" Foreground="#2B2B2B" FontSize="10.5" FontWeight="SemiBold" Padding="4,2">
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Margin="0,4,0,2">
                    <ListBox ItemsSource="{Binding Logs}" Height="110" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D4D4D4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                    <Setter Property="Foreground" Value="#4EC9B0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#DCDCAA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F48771"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Expander>
        </Border>
    </Grid>
</UserControl>
