<Window x:Class="AutoMaterial.Views.AppearanceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalização Visual — AutoMaterial"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="RadioButton" x:Key="ModernRadio">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Padding="22" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
            <!-- Título e Subtítulo -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock x:Name="lblMaterialTitle"
                           Text="Escolha a Aparência do Material"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Selecione uma das 3 texturas reais encontradas na internet, anexe sua própria imagem ou use apenas cor sólida RGB."
                           FontSize="12"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- OPÇÃO 1: TEXTURAS ENCONTRADAS NA INTERNET -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <RadioButton x:Name="rbInternet"
                                 Style="{StaticResource ModernRadio}"
                                 Content="Opção 1: Textura Real Encontrada na Internet (Recomendado)"
                                 Checked="RbOption_Checked"/>
                    
                    <TextBlock Text="Selecione 1 das 3 opções de imagens fotorrealistas para o material:"
                               FontSize="11.5"
                               Foreground="#64748B"
                               Margin="22,3,0,10"/>

                    <!-- Galeria das 3 Imagens -->
                    <Grid x:Name="grdTextures" Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card Imagem 1 -->
                        <Border x:Name="brdImg1"
                                Grid.Column="0"
                                Background="#F1F5F9"
                                BorderBrush="#2563EB"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="6"
                                Cursor="Hand"
                                MouseLeftButtonDown="BrdImg1_Click">
                            <StackPanel>
                                <Border Height="110" Background="#E2E8F0" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="imgCard1" Stretch="UniformToFill"/>
                                </Border>
                                <RadioButton x:Name="rbCard1"
                                             GroupName="TextureCards"
                                             Content="Opção 1"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="#1E293B"
                                             Margin="0,6,0,2"
                                             Checked="RbCard1_Checked"/>
                                <TextBlock x:Name="lblTitle1"
                                           Text="Carregando..."
                                           FontSize="10"
                                           Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Card Imagem 2 -->
                        <Border x:Name="brdImg2"
                                Grid.Column="2"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Cursor="Hand"
                                MouseLeftButtonDown="BrdImg2_Click">
                            <StackPanel>
                                <Border Height="110" Background="#E2E8F0" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="imgCard2" Stretch="UniformToFill"/>
                                </Border>
                                <RadioButton x:Name="rbCard2"
                                             GroupName="TextureCards"
                                             Content="Opção 2"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="#1E293B"
                                             Margin="0,6,0,2"
                                             Checked="RbCard2_Checked"/>
                                <TextBlock x:Name="lblTitle2"
                                           Text="Carregando..."
                                           FontSize="10"
                                           Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Card Imagem 3 -->
                        <Border x:Name="brdImg3"
                                Grid.Column="4"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Cursor="Hand"
                                MouseLeftButtonDown="BrdImg3_Click">
                            <StackPanel>
                                <Border Height="110" Background="#E2E8F0" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="imgCard3" Stretch="UniformToFill"/>
                                </Border>
                                <RadioButton x:Name="rbCard3"
                                             GroupName="TextureCards"
                                             Content="Opção 3"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="#1E293B"
                                             Margin="0,6,0,2"
                                             Checked="RbCard3_Checked"/>
                                <TextBlock x:Name="lblTitle3"
                                           Text="Carregando..."
                                           FontSize="10"
                                           Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OPÇÃO 2: ANEXAR IMAGEM PRÓPRIA -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <RadioButton x:Name="rbCustomFile"
                                 Style="{StaticResource ModernRadio}"
                                 Content="Opção 2: Anexar Imagem Própria (.jpg / .png)"
                                 Checked="RbOption_Checked"/>
                    
                    <Grid Margin="22,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCustomFilePath"
                                 Height="32"
                                 FontSize="12"
                                 Padding="6,4"
                                 Background="#F8FAFC"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Text="Nenhum arquivo selecionado..."/>
                        <Button x:Name="btnBrowseCustomFile"
                                Grid.Column="1"
                                Content="📁 Procurar Imagem..."
                                Width="140"
                                Height="32"
                                Margin="8,0,0,0"
                                Background="#E2E8F0"
                                Foreground="#1E293B"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnBrowseCustomFile_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OPÇÃO 3: APENAS COR RGB SÓLIDA -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <RadioButton x:Name="rbRgbOnly"
                                 Style="{StaticResource ModernRadio}"
                                 Content="Opção 3: Usar Apenas Cor Sólida RGB (Sem textura de imagem)"
                                 Checked="RbOption_Checked"/>
                    <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                        <Border x:Name="brdColorPreview"
                                Width="28"
                                Height="22"
                                Background="#D2B48C"
                                BorderBrush="#94A3B8"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="lblRgbInfo"
                                   Text="Cor calculada pela IA: R=210, G=180, B=140"
                                   FontSize="12"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Botões de Rodapé -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBack"
                        Grid.Column="1"
                        Content="Voltar"
                        Width="105"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnBack_Click"/>

                <Button x:Name="btnConfirm"
                        Grid.Column="2"
                        Content="Aplicar e Finalizar"
                        Width="160"
                        Height="36"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="BtnConfirm_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
