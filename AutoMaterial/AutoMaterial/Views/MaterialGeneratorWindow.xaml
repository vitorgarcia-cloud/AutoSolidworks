<Window x:Class="AutoMaterial.Views.MaterialGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoMaterial — Criador Autônomo de Materiais (IA)"
        Icon="pack://application:,,,/AutoMaterial;component/Assets/AppIcon.png"
        Width="560"
        Height="730"
        MinWidth="500"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E22"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- ========================================================================= -->
        <!-- PALETA AUTOSOLID (ALTO CONTRASTE + APPLE DARK THEME)                      -->
        <!-- ========================================================================= -->
        <SolidColorBrush x:Key="AppleBgBrush" Color="#1E1E22"/>
        <SolidColorBrush x:Key="AppleCardBgBrush" Color="#2A2A30"/>
        <SolidColorBrush x:Key="AppleCardBorderBrush" Color="#464650"/>
        <SolidColorBrush x:Key="AppleInputBgBrush" Color="#222226"/>
        <SolidColorBrush x:Key="AppleInputBorderBrush" Color="#5A5A66"/>
        <SolidColorBrush x:Key="AppleInputBorderHoverBrush" Color="#7E7E90"/>
        
        <!-- Tipografia de Alto Contraste (Totalmente legível) -->
        <SolidColorBrush x:Key="AppleTextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppleTextSecondaryBrush" Color="#D2D2D8"/>
        <SolidColorBrush x:Key="AppleTextMutedBrush" Color="#B0B0BC"/>

        <!-- AutoSolid Crimson Brand Red -->
        <SolidColorBrush x:Key="AutoSolidRedBrush" Color="#D32323"/>
        <SolidColorBrush x:Key="AutoSolidRedHoverBrush" Color="#E52B2B"/>
        <SolidColorBrush x:Key="AutoSolidRedLightBgBrush" Color="#441E1E"/>
        <SolidColorBrush x:Key="AutoSolidRedBorderBrush" Color="#FF4D4D"/>
        <SolidColorBrush x:Key="AutoSolidRedHighlightBrush" Color="#FFA0A0"/>

        <!-- Botões Secundários & Vidro Escuro -->
        <SolidColorBrush x:Key="AppleBtnSecBgBrush" Color="#383840"/>
        <SolidColorBrush x:Key="AppleBtnSecHoverBrush" Color="#4A4A54"/>
        <SolidColorBrush x:Key="AppleBtnSecBorderBrush" Color="#60606C"/>

        <!-- ========================================================================= -->
        <!-- ESTILOS APPLE DE ALTO CONTRASTE E VISIBILIDADE CRISTALINA                -->
        <!-- ========================================================================= -->

        <!-- Rótulo de Campo (Branco Puro e Seminegrito) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Subtítulo de Seção (Card Header) -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TextBox Estilo Apple (Texto Branco Puro, Sem Cortes de Altura) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource AppleInputBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppleInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          TextElement.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                                <Setter TargetName="PART_ContentHost" Property="Margin" Value="10,6"/>
                                <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AppleInputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AutoSolidRedBorderBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#222228"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="Background" Value="#26262B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Estilo Apple (Bullets e Texto em Branco Puro) -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource AppleInputBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppleInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          TextElement.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AppleInputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AutoSolidRedBorderBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#222228"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Item Estilo Apple Dark (Texto Branco Puro) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource AppleCardBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
                            <ContentPresenter TextElement.Foreground="#FFFFFF" TextBlock.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AutoSolidRedLightBgBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AutoSolidRedLightBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AutoSolidRedHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Estilo Apple Dark (Com Texto de Seleção em Branco Puro) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource AppleInputBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppleInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="{StaticResource AppleInputBgBrush}"
                                                BorderBrush="{StaticResource AppleInputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <!-- Chevron nítido em branco puro -->
                                                    <Path Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="#FFFFFF"
                                                          StrokeThickness="1.8"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource AppleInputBorderHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- TEXTO SELECIONADO: TextElement.Foreground forçado para branco puro -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#FFFFFF"
                                              TextBlock.Foreground="#FFFFFF"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="260">
                                    <Border Background="{StaticResource AppleCardBgBrush}"
                                            BorderBrush="{StaticResource AppleCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" Opacity="0.55" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário Apple + AutoSolid Crimson -->
        <Style x:Key="ApplePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                BorderBrush="{StaticResource AutoSolidRedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D62828" Offset="0"/>
                                    <GradientStop Color="#B71C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#C81E1E" BlurRadius="10" Opacity="0.35" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA0A0"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E63535" Offset="0"/>
                                            <GradientStop Color="#C81E1E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Apple Dark (Vidro Escuro de Alto Contraste) -->
        <Style x:Key="AppleSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppleBtnSecBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppleBtnSecBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AppleBtnSecHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7E7E90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton Apple Minimalista de Alto Contraste -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="outerCircle"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Background="{StaticResource AppleInputBgBrush}"
                                    BorderBrush="{StaticResource AppleInputBorderBrush}"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="innerDot"
                                         Width="9" Height="9"
                                         Fill="{StaticResource AutoSolidRedBrush}"
                                         Visibility="Collapsed"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"
                                              TextElement.Foreground="#FFFFFF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerCircle" Property="BorderBrush" Value="{StaticResource AutoSolidRedBrush}"/>
                                <Setter TargetName="innerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerCircle" Property="BorderBrush" Value="{StaticResource AutoSolidRedHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar Estilo Apple Crimson -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AutoSolidRedBrush}"/>
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C81E1E" Offset="0"/>
                                        <GradientStop Color="#FF453A" Offset="0.5"/>
                                        <GradientStop Color="#C81E1E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Conteúdo Principal Redimensionável -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Linha 0: Cabeçalho Hero -->
            <RowDefinition Height="*"/>    <!-- Linha 1: Cartões com Rolagem Flexível -->
            <RowDefinition Height="Auto"/> <!-- Linha 2: Rodapé Ancorado -->
        </Grid.RowDefinitions>

        <!-- CABEÇALHO HERO (APPLE DESIGN) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ícone do Aplicativo Estilo Apple Squircle -->
                    <Border Width="44" Height="44"
                            CornerRadius="10"
                            ClipToBounds="True"
                            Margin="0,0,12,0"
                            BorderBrush="#464650"
                            BorderThickness="1"
                            Background="#222226">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.4" ShadowDepth="2"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/AutoMaterial;component/Assets/AppIcon.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AutoMaterial"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>

                        <TextBlock Text="Geração autônoma de propriedades mecânicas, modelo CAE e textura."
                                   FontSize="12"
                                   Foreground="{StaticResource AppleTextSecondaryBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botão Configurações do Provedor de IA (Engrenagem Estilo Apple) -->
                <Button x:Name="btnToggleSettings"
                        Grid.Column="1"
                        Style="{StaticResource AppleSecondaryButtonStyle}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Configurações do Provedor de IA (Chave e Modelos)"
                        Click="BtnToggleSettings_Click">
                    <TextBlock Text="⚙️"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

        <!-- ÁREA CENTRAL COM CARDS (ROLAGEM SUAVE AO REDIMENSIONAR COM O MOUSE) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,12"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- PAINEL DE INPUTS EM CARDS SEPARADOS -->
                <StackPanel x:Name="pnlInputs">

                <!-- CARD 1: CONFIGURAÇÕES DA IA -->
                <Border x:Name="cardAiSettings"
                        Visibility="Collapsed"
                        Background="{StaticResource AppleCardBgBrush}"
                        BorderBrush="{StaticResource AppleCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Header do Card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Configurações do Provedor de IA" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>

                        <!-- Provedor + API Key -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Provedor" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cmbProvider"
                                          Height="34"
                                          SelectionChanged="CmbProvider_SelectionChanged">
                                    <ComboBoxItem Content="Google Gemini" IsSelected="True"/>
                                    <ComboBoxItem Content="OpenAI (GPT)"/>
                                    <ComboBoxItem Content="DeepSeek"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- API Key com Opção de Revelar/Ocultar -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock x:Name="lblApiKey"
                                           Text="API Key:"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Campo de Senha Mascarado -->
                                    <PasswordBox x:Name="txtApiKey"
                                                 Grid.Column="0"
                                                 Height="34"
                                                 PasswordChanged="TxtApiKey_PasswordChanged"
                                                 ToolTip="Sua chave é salva localmente e de forma isolada por provedor."/>

                                    <!-- Campo de Texto Revelado -->
                                    <TextBox x:Name="txtApiKeyVisible"
                                             Grid.Column="0"
                                             Height="34"
                                             Visibility="Collapsed"
                                             TextChanged="TxtApiKeyVisible_TextChanged"
                                             ToolTip="Sua chave é salva localmente e de forma isolada por provedor."/>

                                    <!-- Botão de Revelar/Ocultar com Altura 34px (Alinhado ao Campo) -->
                                    <Button x:Name="btnToggleApiKey"
                                            Grid.Column="1"
                                            Style="{StaticResource AppleSecondaryButtonStyle}"
                                            Content="👁️ Ver"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Height="34"
                                            Width="72"
                                            Margin="6,0,0,0"
                                            Cursor="Hand"
                                            ToolTip="Alterna entre visualização oculta e legível da API Key"
                                            Click="BtnToggleApiKey_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Modelo de IA + Botão de Busca -->
                        <StackPanel>
                            <TextBlock Text="Modelo de IA" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cmbModel"
                                          Grid.Column="0"
                                          Height="34"/>

                                <Button x:Name="btnBuscarModelos"
                                        Grid.Column="1"
                                        Style="{StaticResource AppleSecondaryButtonStyle}"
                                        Content="🔍 Buscar Modelos"
                                        Width="140"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        ToolTip="Detecta os modelos liberados na sua conta do Google AI Studio"
                                        Click="BtnBuscarModelos_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: ESPECIFICAÇÃO TÉCNICA DO MATERIAL -->
                <Border Background="{StaticResource AppleCardBgBrush}"
                        BorderBrush="{StaticResource AppleCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Header do Card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔬" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Especificação do Material" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>

                        <!-- Nome do Material -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Nome Comercial ou Norma *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtMaterialName"
                                     Height="34"
                                     ToolTip="Ex: Aço ABNT 1045, Alumínio 6061-T6, Borracha NBR 70 ShA, PEEK Carbon Fiber, MDF"/>
                        </StackPanel>

                        <!-- Contexto Adicional -->
                        <StackPanel>
                            <TextBlock Text="Contexto Adicional (Opcional)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtAdditionalContext"
                                     Height="54"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     ToolTip="Informações extras: estado térmico, aplicação mecânica, tipo de fibra ou fornecedor."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: APARÊNCIA VISUAL & TEXTURA -->
                <Border Background="{StaticResource AppleCardBgBrush}"
                        BorderBrush="{StaticResource AppleCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Header do Card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Aparência Visual &amp; Textura da Peça" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>

                        <!-- Opção 1: Anexar Imagem -->
                        <RadioButton x:Name="rbAttachImage"
                                     Content="Anexar Imagem de Textura (.jpg / .png / .bmp)"
                                     IsChecked="False"
                                     Checked="RbAppearance_Checked"
                                     Unchecked="RbAppearance_Checked"/>
                        <TextBlock Text="A imagem é salva na pasta do SolidWorks e vinculada diretamente à peça como textura 3D."
                                   FontSize="11.5"
                                   Foreground="{StaticResource AppleTextSecondaryBrush}"
                                   Margin="24,2,0,8"/>

                        <!-- Campo de Navegação de Imagem -->
                        <Grid x:Name="pnlImageBrowse" Margin="24,0,0,12" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCustomTexturePath"
                                     Height="32"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Text="Nenhuma imagem anexada... (clique em Procurar Imagem)"/>
                            <Button x:Name="btnBrowseTexture"
                                    Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    Content="📁 Procurar Imagem..."
                                    Width="140"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Click="BtnBrowseTexture_Click"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppleCardBorderBrush}" Margin="24,0,0,10"/>

                        <!-- Opção 2: Apenas Cor RGB -->
                        <RadioButton x:Name="rbRgbOnly"
                                     Content="Apenas Cor Sólida RGB sugerida pela IA (Sem textura de imagem)"
                                     IsChecked="False"
                                     Checked="RbAppearance_Checked"
                                     Unchecked="RbAppearance_Checked"/>
                        <TextBlock Text="Aplica a cor espectral calculada para o material, sem mapeamento fotográfico."
                                   FontSize="11.5"
                                   Foreground="{StaticResource AppleTextSecondaryBrush}"
                                   Margin="24,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ESTADO VISUAL DE LOADING (APPLE TRANSLUCENT CRIMSON) -->
            <Border x:Name="brdLoading"
                    Visibility="Collapsed"
                    Background="{StaticResource AutoSolidRedLightBgBrush}"
                    BorderBrush="{StaticResource AutoSolidRedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="lblLoadingStatus"
                               Text="Consultando a IA, classificando modelo constitutivo e aparência fotorrealista..."
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AutoSolidRedHighlightBrush}"
                               Margin="0,0,0,8"/>
                    <ProgressBar x:Name="pbLoading"
                                 IsIndeterminate="True"
                                 Height="6"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RODAPÉ COM BOTÕES DE AÇÃO (SEMPRE ANCORADO NA BASE) -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel"
                    Grid.Column="1"
                    Style="{StaticResource AppleSecondaryButtonStyle}"
                    Content="Cancelar"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>

            <Button x:Name="btnGenerate"
                    Grid.Column="2"
                    Style="{StaticResource ApplePrimaryButtonStyle}"
                    Content="Gerar Material"
                    Width="150"
                    Height="36"
                    IsEnabled="False"
                    ToolTip="Selecione uma imagem anexada ou a opção de cor RGB para habilitar a geração"
                    IsDefault="True"
                    Click="BtnGenerate_Click"/>
        </Grid>
    </Grid>
</Window>